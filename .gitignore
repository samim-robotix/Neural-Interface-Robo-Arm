# ==============================================================================
# Git Ignore Configuration for BCI Robotic Arm Visual Stimulus & Firmware
# ==============================================================================

# PlatformIO & Embedded Build Artifacts
.pio/
**/.pio/
*.pio
.pioenvs/
.piolibdeps/

# Microcontroller Compilation Binaries & Objects
*.hex
*.bin
*.elf
*.o
*.d
*.obj
*.a
*.lib

# IDE & Editor Files
.vscode/
**/.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Visual Studio, C++ & .NET Build Artifacts
bin/
**/bin/
obj/
**/obj/
Debug/
**/Debug/
Release/
**/Release/
.vs/
**/.vs/
*.suo
*.sdf
*.user
*.userosscache
*.sln.docstates
*.tlog
*.baml
*.g.cs
*.g.i.cs
*.vshost.exe*
*.manifest
*.cache
*.ilk
*.pdb
*.idb
*.metagen

# Heavy Installers & Large System Binaries
*.exe
*.msi
*.deb
**/SDK_GEN2_1_5_1_install*

# Python Virtual Environments & Cache (for Host EEG/CV pipelines)
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# Large Archives & Compressed Backups
*.zip
*.tar.gz
*.rar
*.7z

# Large Media Files (Files > 100 MB cannot be pushed directly to GitHub)
*.mp4
*.mov
*.avi
*.mkv
# Allow compressed web-friendly demo video embeds in assets/videos if added
!assets/videos/*.mp4
!assets/videos/*.webm

# Sensitive Hardware Credentials & License Keys
**/Password.txt
**/serial number*.txt
